// J-Link Commander Script for KW45 RAM Download & Execution
// Usage: JLink.exe .\run_ram.jlink
// Update the binary path and vector-derived register values for each image.

ExitOnError 1

// Select the target device, interface and speed before connecting.
device KW45B41Z83
si SWD
speed 4000
connect

// Reset and halt before loading the Secure RAM image.
r
h

// Load the image and verify readback before starting the CPU.
LoadFile "D:/NXP/work-prj/kw45b41zevk_freertos_hello/freertos_hello.bin" 0x30008000 noreset
VerifyBin "D:/NXP/work-prj/kw45b41zevk_freertos_hello/freertos_hello.bin" 0x30008000
Mem32 0x30008000 2

// Select MSP in privileged Thread mode, then install the image vector base.
WReg CONTROL 0x00000000
W4 0xE000ED08 0x30008000

// MSP = vector Word 0. PC = vector Word 1 with the Thumb bit removed.
WReg MSP 0x30018000
SetPC 0x3000847C
WReg XPSR 0x01000000
Regs

// Reset_Handler sets MSPLIM and initializes m_data1 ECC before using the stack.
g
Exit
